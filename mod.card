return {
  summary = "ALPHA / proof of concept. R/S-style Pokemon Contests in Kanto and Johto: pick one of the five contests -- COOL, BEAUTY, CUTE, SMART or TOUGH -- and appeal to the judge, scored by each move's contest category.",
  author = "Mister Miracle",
  tags = { "contests", "quest", "celadon", "goldenrod", "alpha" },
  differences = {
    "Adds a Contest Hall map reachable from Celadon City (ask the little girl).",
    "Adds a contest judge who runs all five contests; you pick one and appeal in a battle-style round.",
    "Every move carries a contest category, shown in place of its type during a contest.",
    "Adds five earned contest scarves that boost matching Introduction scores.",
    "Three rival coordinators appear in every contest and can jam your routine, healing the judge's meter.",
    "Contests award no EXP and allow no switching or items -- one POKeMON performs the whole routine.",
    "Records contest wins per category on the POKeMON so Kanto Ribbons can award the matching ribbon.",
  },
  credits = { "Contest design based on Pokemon Ruby/Sapphire." },
  compat = "Takes over TEXT_CELADONCITY_LITTLE_GIRL (with vanilla fallback on decline). Kanto Ribbons 0.18.0+ optional; it has artwork for the Cool Ribbon only, so the other four contests record their win and award retroactively once it draws them. Contest HUD is drawn for the classic battle layout; the widescreen layout plays but looks like an ordinary battle."
}
